{
    "engine": {
        "target_fps": 30,
        "input_timeout": 0.05,
        "math_center_divisor": 2,
        "plugins": ["advanced_greeter"]
    },
    "theme": {
        "bg_color": [15, 15, 20],
        "box_bg": [30, 30, 40],
        "text_main": [220, 220, 220],
        "text_accent": [255, 100, 100],
        "text_error": [255, 80, 80],
        "text_success": [80, 255, 80]
    },
    "layout": {
        "z_background": 0,
        "z_ui_base": 4,
        "z_ui_elements": 5,
        "z_overlay": 10,
        "box_width": 44,
        "box_height": 14,
        "box_x": "center",
        "box_y": "center",
        "title_y_offset": 2,
        "user_y_offset": 6,
        "pass_y_offset": 8,
        "msg_y_offset": 11,
        "x_padding": 4
    },
    "text": {
        "title": " standalone-dm ",
        "user_active": "> user: ",
        "user_idle": "  user: ",
        "pass_active": "> pass: ",
        "pass_idle": "  pass: ",
        "mask_char": "*",
        "msg_authenticating": "Authenticating...",
        "msg_success": "Login successful. Starting...",
        "msg_fail": "Authentication failed."
    },
    "system": {"default_session_cmd": ["Hyprland"], "empty_string": ""}
}
